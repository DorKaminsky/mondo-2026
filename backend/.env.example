NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/mondo2026

# JWT
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=7d

# Frontend URL (used for CORS in production and email links)
FRONTEND_URL=http://localhost:5173

# Email (nodemailer) — optional; if SMTP_USER is empty, emails are skipped
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@mondo2026.com

# Admin (optional)
ADMIN_EMAIL=admin@mondo2026.com
